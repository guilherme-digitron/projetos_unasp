<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contador"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#333333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/tvContador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="72sp"
        android:textStyle="bold"
        android:textColor="#0066cc"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp" />

    <LinearLayout
        android:id="@+id/llBotoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:spacing="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvContador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp">

        <Button
            android:id="@+id/btnDiminuir"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="−"
            android:textSize="40sp"
            android:textColor="#ffffff"
            android:backgroundTint="#ff6b6b"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/btnAumentar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="+"
            android:textSize="40sp"
            android:textColor="#ffffff"
            android:backgroundTint="#51cf66"
            android:layout_margin="8dp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnResetar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resetar"
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:backgroundTint="#666666"
        app:layout_constraintTop_toBottomOf="@id/llBotoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:padding="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
